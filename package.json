{
  "name": "the-quiet-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.5.2 <12"
  },
  "packageManager": "npm@11.5.2",
  "prettier": {
    "singleQuote": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "npm run build:save-validator && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "npm run build:save-validator && vitest run",
    "build:save-validator": "node tools/build-save-validator.mjs",
    "test:portable": "node tools/build-storage-fixture.mjs && playwright test \"portable-(db|ui).spec.ts\" navigation.spec.ts --output test-results/portable",
    "test:e2e": "playwright test foundation.spec.ts engine.spec.ts ast.spec.ts editor.spec.ts boot-benchmark.spec.ts pwa-spike.spec.ts",
    "test:workspace": "playwright test workspace-layout.spec.ts workspace-results.spec.ts workspace-editor.spec.ts workspace-recovery.spec.ts workspace-offline.spec.ts --output test-results/workspace",
    "test:storage": "node tools/build-storage-fixture.mjs && playwright test \"storage-(create|drafts|recovery|ui).spec.ts\" --output test-results/storage",
    "test:pwa-update": "playwright test --config playwright.m0.config.ts",
    "benchmark:boot": "playwright test --config playwright.benchmark.config.ts",
    "test:visual": "playwright test visual.spec.ts --project chromium",
    "test:a11y": "playwright test a11y.spec.ts",
    "build": "npm run verify:vendor && npm run build:save-validator && node tools/build-base-snapshot.mjs && node tools/build-proof-icons.mjs && vite build && node tools/verify-foundation.mjs && node tools/verify-third-party.mjs --dist && node tools/verify-m0-dist.mjs",
    "smoke:dist": "playwright test --grep @smoke",
    "verify:vendor": "node tools/verify-third-party.mjs",
    "validate:content": "node tools/pending-gate.mjs validate:content",
    "test:fixtures": "node tools/pending-gate.mjs test:fixtures"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "0.5.13",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "libpg-query": "18.2.2",
    "lit": "3.3.3"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "workbox-build": {
      "glob": "14.0.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/emscripten": "1.41.6",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-plugin-lit": "2.3.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1"
  }
}
