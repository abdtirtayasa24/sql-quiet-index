# Machine-local Graphify interpreters, caches and extraction intermediates.
# Keep the portable graph, report and interactive HTML available for review.
/graphify-out/.*
/graphify-out/cache/
/graphify-out/manifest.json
/graphify-out/cost.json
/graphify-out/__pycache__/

# Local dependencies, build/content staging and test evidence.
/node_modules/
/dist/
/generated/
/dist-m0-a/
/dist-m0-b/
/public/content/
/test-results/
/playwright-report/
/coverage/
*.tsbuildinfo

# Never publish local configuration, credentials or private keys.
.env
.env.*
!.env.example
*.pem
*.key
npm-debug.log*
